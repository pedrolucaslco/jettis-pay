---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { waLink } from "../lib/whatsapp";

const columns = [
  {
    title: "Links rápidos",
    links: [
      { label: "Início", href: "/" },
      { label: "Soluções", href: "/#solucoes" },
      { label: "Vantagens", href: "/#vantagens" },
      { label: "Como funciona", href: "/#como-funciona" },
    ],
  },
  {
    title: "Institucional",
    links: [
      { label: "Sobre nós", href: "/#sobre" },
      { label: "Seja um parceiro", href: waLink("Olá! Quero ser um parceiro Jettis Pay."), target: "_blank" },
      { label: "Termos de uso", href: "/termos-de-uso" },
      { label: "Política de privacidade", href: "/politica-de-privacidade" },
    ],
  },
  {
    title: "Suporte",
    links: [
      { label: "Central de ajuda", href: "#", hidden: true },
      { label: "Fale conosco", href: waLink("Olá! Preciso falar com o suporte da Jettis Pay."), target: "_blank" },
      { label: "Perguntas frequentes", href: "#", hidden: true },
    ],
  },
];
---

<footer id="sobre" class="border-t border-white/5 px-8 py-16">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div id="contato">
        <Logo class="mb-3" />
        <p class="text-sm text-text-muted">Pagamentos simples para negócios que não param.</p>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="mb-4 font-semibold">{col.title}</p>
            <ul class="space-y-2 text-sm text-text-muted">
              {col.links.map((link) => (
                <li class={link.hidden ? "hidden" : undefined}>
                  <a
                    href={link.href}
                    target={link.target}
                    rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
                    class="hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-sm text-text-muted sm:flex-row">
      <p>© 2026 Jettis Pay. Todos os direitos reservados.</p>
      <div class="hidden gap-4">
        <a href="#" aria-label="Instagram" class="hover:text-white"><Icon name="instagram" class="size-5" /></a>
        <a href="#" aria-label="Facebook" class="hover:text-white"><Icon name="facebook" class="size-5" /></a>
        <a href="#" aria-label="LinkedIn" class="hover:text-white"><Icon name="linkedin" class="size-5" /></a>
      </div>
    </div>
  </div>
</footer>
