---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";
import { waLink } from "../lib/whatsapp";

const highlights: { icon: IconName; label: string }[] = [
  { icon: "shield-check", label: "Segurança de ponta" },
  { icon: "clock", label: "Liquidação rápida" },
  { icon: "headset", label: "Suporte especializado" },
  { icon: "trending-up", label: "Mais conversão para seu negócio" },
];
---

<section class="relative overflow-hidden px-8 pb-20 pt-16">
  <div class="pointer-events-none absolute -z-10 right-0 top-16 size-[36rem] translate-x-1/4 rounded-full bg-brand-blue/40 blur-3xl"></div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--color-brand-purple)_0%,_transparent_45%)] opacity-20"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-2">
    <div class="order-2 text-center lg:order-1 lg:text-left">
      <span class="mb-6 inline-block rounded-full border border-white/10 bg-white/5 px-4 py-1 text-xs font-medium uppercase tracking-wide text-brand-blue">
        Jettis Pay
      </span>
      <h1 class="text-4xl font-semibold leading-tight sm:text-5xl">
        Pagamento simples <br />para negócios <br /><span class="text-gradient-brand">que não param.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-md text-text-muted lg:mx-0">
        A Jettis Pay é a solução completa de pagamentos da Jettis. Mais conversão, menos
        burocracia e total segurança para o seu negócio crescer.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
        <Button href={waLink("Olá! Quero aumentar minhas vendas com a Jettis Pay.")} target="_blank" icon="arrow-right">
          Quero aumentar minhas vendas
        </Button>
        <Button href={waLink("Olá! Quero falar com um especialista da Jettis Pay.")} target="_blank" variant="outline">
          Falar com um especialista
        </Button>
      </div>

      <div class="mt-12 grid grid-cols-2 gap-6 text-left sm:grid-cols-4">
        {
          highlights.map((item) => (
            <div class="flex flex-col gap-3">
              <div class="flex size-14 items-center justify-center rounded-full bg-brand-blue/10">
                <Icon name={item.icon} class="size-7 shrink-0 text-brand-blue" />
              </div>
              <p class="text-sm text-text-muted">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="relative order-1 flex justify-center lg:order-2">
      <img
        src="/hero-image.png"
        alt="Celular exibindo pagamento aprovado, maquininha Jettis e cartões"
        class="relative w-full max-w-[62.4rem]"
      />
    </div>
  </div>
</section>
