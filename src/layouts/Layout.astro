---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jettis Pay — Pagamento simples para negócios que não param",
  description = "A Jettis Pay é a solução completa de pagamentos da Jettis. Mais conversão, menos burocracia e total segurança para o seu negócio crescer.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-text antialiased">
    <slot />
  </body>
</html>
